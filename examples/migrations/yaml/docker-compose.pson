{
  // Migrated from docker-compose.yml YAML -> PSON
  // Benefits: tuple for ports (pair), dict for volumes (mapping), @env for secrets, type-safe
  version: "3.8",
  services: {
    web: {
      image: "nginx:latest",
      ports: [(80, 80), (443, 443)],  // tuple! (host, container) pair - clear it's not just list
      environment: {
        DEBUG: true,
        PORT: 80
      },
      volumes: {
        "./src": "/app",
        "./nginx.conf": "/etc/nginx/nginx.conf"
      },
      depends_on: ["db"]
    },
    db: {
      image: "postgres:15",
      environment: {
        POSTGRES_DB: "mydb",
        POSTGRES_USER: "user",
        POSTGRES_PASSWORD: @env("DB_PASSWORD", default="secret")  // secret via env, not hardcoded!
      },
      volumes: {
        db_data: "/var/lib/postgresql/data"
      }
    }
  },
  volumes: {
    db_data: null
  }
}
